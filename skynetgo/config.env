# SkynetGO Remote - build-time customization of the RustDesk client.
# Read by skynetgo/apply.py, which patches libs/hbb_common/src/config.rs before the
# build. Everything here is PUBLIC (it is compiled into a binary you distribute).
# No secrets belong in this file.

# Compiled-in app identity. Drives the config directory (%APPDATA%\<APP_NAME>), the
# Windows service name, the install path (C:\Program Files\<APP_NAME>), the installed
# exe name, and the tray single-instance mutex - which is what lets this coexist with a
# stock RustDesk on the same machine. Letters and digits only.
APP_NAME=SkynetGORemote
ORG=org.skynetgo

# Rendezvous (ID) server. Port defaults to 21116. hbbs advertises the relay itself
# (its -r flag), so there is no relay-server entry here.
RENDEZVOUS_SERVER=remote.skynetgo.org

# Public half of the server keypair: id_ed25519.pub on the VM, vault_rustdesk_public_key
# in the skynet repo's inventory/group_vars/prod/vault.yml. Generate ONCE with
# `rustdesk-utils genkeypair` and never rotate without rebuilding this client - every
# deployed copy pins it. The build refuses to run while this is empty (except with the
# workflow's allow_empty_key smoke-test input).
RS_PUB_KEY=zz0IW/sBnfKkGu/m9HHi4xs5IuyXSaGuO/TSVsyGFQA=

# Address book / console: lejianwen/rustdesk-api behind the VM's nginx. Seeded as the
# client's default `api-server`; without it the client derives http://<rendezvous>:21114,
# which the VM does not expose.
API_SERVER=https://remote.skynetgo.org
